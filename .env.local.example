# ==============================================================================
# HYMF Portal - Çevre Değişkenleri (Environment Variables)
# ==============================================================================

# Supabase Bağlantı Bilgileri (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (Opsiyonel / İleri düzey admin işlemleri için)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Telegram Bot Entegrasyonu (@BotFather üzerinden alınan Token ve Grup ID)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Uygulama Temel URL'i (Lokalde http://localhost:3000, Canlıda Vercel linkiniz)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
